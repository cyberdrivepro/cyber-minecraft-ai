# ==================================================
# CYBER MINECRAFT AI MOD BUILDER - CONFIGURATION
# ==================================================

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Hugging Face User Access Token (read permission)
HF_TOKEN=

# AI Provider: local, huggingface_inference, groq, openrouter, custom_openai
AI_PROVIDER=local

# Local Model ID on Hugging Face Hub
LOCAL_MODEL_ID=Qwen/Qwen2.5-Coder-1.5B-Instruct
AUTO_MODEL=true

# Vision Model for reference image analysis (optional)
VISION_MODEL_ID=

# Admin Token for protected REST API routes
ADMIN_TOKEN=

# Concurrency & Error Self-Repair Limits
MAX_CONCURRENT_BUILDS=1
MAX_REPAIR_ATTEMPTS=3

# Storage Paths (use /data for persistent Hugging Face Spaces storage)
DATA_DIR=./data
OUTPUT_DIR=./data/outputs
STORAGE_MODE=local

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Java 21+ Home for Fabric Gradle builds (optional if in PATH)
JAVA_HOME=

# Optional Cloud AI API Fallback Keys
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
