# ==================================================
# CYBER MINECRAFT AI - CONFIGURATION (placeholders only)
# ==================================================

# Telegram Bot Token from @BotFather (leave empty to run without the bot)
TELEGRAM_BOT_TOKEN=

# Hugging Face User Access Token (read permission) for model downloads / HF Inference
HF_TOKEN=

# AI Provider: local, huggingface_inference, groq, openrouter, custom_openai
AI_PROVIDER=local

# Local Model ID on Hugging Face Hub (loads on demand; needs RAM when loaded)
LOCAL_MODEL_ID=Qwen/Qwen2.5-Coder-1.5B-Instruct
AUTO_MODEL=true

# Vision Model for reference image analysis (optional)
VISION_MODEL_ID=

# ---- Web security ----------------------------------------------------------
# Bootstrap admin account (if ADMIN_PASSWORD is empty, generated credentials
# are written to data/admin_credentials.txt on first boot - keep it private)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set false ONLY for private single-user installs on trusted networks
AUTH_REQUIRED=true
ALLOW_REGISTRATION=true
# Token used by the CLI (scripts/cyber-minecraft-ai) for local API management
ADMIN_TOKEN=
# Download-link lifetime in hours
DOWNLOAD_TOKEN_TTL_HOURS=24

# Concurrency & Error Self-Repair Limits
MAX_CONCURRENT_BUILDS=1
MAX_REPAIR_ATTEMPTS=3
MAX_BUILD_SECONDS=180

# ---- Cyber Host (Minecraft server hosting) ---------------------------------
MAX_SERVERS_PER_OWNER=10
MAX_CONCURRENT_SERVERS=2
SERVER_PORT_MIN=25565
SERVER_PORT_MAX=25600
SERVER_RAM_MB=1024
MAX_BACKUPS_PER_SERVER=5
SERVER_JAR_MAX_MB=300
# Auto-shutdown for idle servers in minutes (0 = disabled)
SERVER_IDLE_SHUTDOWN_MINUTES=0
# Public hostname players use to join (an HTTPS web URL is NOT a game address)
SERVER_PUBLIC_HOST=
# Automatically restart servers that were online before the last shutdown
AUTO_RESUME_SERVERS=true

# ---- Storage ----------------------------------------------------------------
# Use /data for persistent Docker/HF-Space storage; local disk may be ephemeral there
DATA_DIR=./data
OUTPUT_DIR=./data/outputs
STORAGE_MODE=local

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Java 21+ Home for real server hosting and Fabric Gradle builds (optional if in PATH)
JAVA_HOME=

# Optional Cloud AI API Fallback Keys (server-side only, never exposed to browsers)
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
